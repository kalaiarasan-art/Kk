rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. UserProfile Validation Blueprint
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 20 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.avatarJson is string && data.avatarJson.size() >= 2 && data.avatarJson.size() <= 1000 &&
             data.bio is string && data.bio.size() <= 160 &&
             data.countryFlag is string && data.countryFlag.size() <= 16 &&
             data.themeColor is string && data.themeColor.size() <= 16 &&
             data.xp is int && data.xp >= 0 &&
             data.level is int && data.level >= 1 && data.level <= 500 &&
             data.equippedTitle is string && data.equippedTitle.size() <= 40 &&
             data.equippedBadge is string && data.equippedBadge.size() <= 40 &&
             data.gamesPlayed is int && data.gamesPlayed >= 0 &&
             data.wins is int && data.wins >= 0 &&
             data.totalPoints is int && data.totalPoints >= 0 &&
             data.correctGuesses is int && data.correctGuesses >= 0 &&
             data.bestGuessMs is int && data.bestGuessMs >= 0 &&
             data.bestStreak is int && data.bestStreak >= 0 &&
             data.unlockedPacksJson is string && data.unlockedPacksJson.size() <= 1000 &&
             data.achievementsJson is string && data.achievementsJson.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 2. Friendship Validation Blueprint
    function isValidFriendship(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.friendCode is string && data.friendCode.size() >= 3 && data.friendCode.size() <= 32 &&
             data.friendUsername is string && data.friendUsername.size() >= 3 && data.friendUsername.size() <= 20 &&
             data.friendDisplayName is string && data.friendDisplayName.size() >= 1 && data.friendDisplayName.size() <= 40 &&
             data.friendAvatarJson is string && data.friendAvatarJson.size() <= 1000 &&
             data.status is string && data.status in ['PENDING', 'ACCEPTED', 'BLOCKED'] &&
             data.roomCode is string && data.roomCode.size() <= 12 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 3. CustomWordPack Validation Blueprint
    function isValidCustomWordPack(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.language is string && data.language.size() >= 2 && data.language.size() <= 10 &&
             data.difficulty is string && data.difficulty in ['EASY', 'MEDIUM', 'HARD', 'MIXED'] &&
             data.isFamilyFriendly is bool &&
             data.wordsCsv is string && data.wordsCsv.size() >= 3 && data.wordsCsv.size() <= 16000 &&
             data.wordCount is int && data.wordCount >= 3 && data.wordCount <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. GameRoom Validation Blueprint
    function isValidGameRoom(data) {
      return data.roomCode is string && data.roomCode.size() == 6 &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40 &&
             data.isPublic is bool &&
             data.phase is string && data.phase in ['LOBBY', 'WORD_CHOICE', 'DRAWING', 'TURN_END', 'GAME_END'] &&
             data.round is int && data.round >= 1 && data.round <= 10 &&
             data.maxRounds is int && data.maxRounds >= 2 && data.maxRounds <= 10 &&
             data.drawTimeSec is int && data.drawTimeSec >= 30 && data.drawTimeSec <= 180 &&
             data.wordChoicesCount is int && data.wordChoicesCount >= 1 && data.wordChoicesCount <= 5 &&
             data.hintsCount is int && data.hintsCount >= 0 && data.hintsCount <= 3 &&
             data.gameMode is string && data.gameMode in ['CLASSIC', 'SPEED_30S', 'BLIND_DRAWER', 'TEAM_BATTLE', 'PASS_THE_DOODLE', 'DAILY_CHALLENGE'] &&
             data.difficulty is string && data.difficulty in ['EASY', 'MEDIUM', 'HARD', 'MIXED'] &&
             data.wordPackCategory is string && data.wordPackCategory.size() >= 1 && data.wordPackCategory.size() <= 40 &&
             data.customWordsCsv is string && data.customWordsCsv.size() <= 16000 &&
             data.currentDrawerId is string && data.currentDrawerId.size() <= 128 &&
             data.currentDrawerName is string && data.currentDrawerName.size() <= 40 &&
             data.wordMask is string && data.wordMask.size() <= 80 &&
             data.secretWord is string && data.secretWord.size() <= 40 &&
             data.phaseEndsAtMs is int && data.phaseEndsAtMs >= 0 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 12 &&
             data.memberUids[0] is string &&
             data.playersJson is string && data.playersJson.size() >= 2 && data.playersJson.size() <= 16000 &&
             data.reactionCountsJson is string && data.reactionCountsJson.size() >= 2 && data.reactionCountsJson.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 5. CanvasOp Validation Blueprint
    function isValidCanvasOp(data, roomId) {
      return data.roomId is string && data.roomId == roomId && data.roomId.size() <= 128 &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorId == request.auth.uid &&
             data.seq is int && data.seq >= 0 && data.seq <= 10000 &&
             data.opType is string && data.opType in ['STROKE', 'SHAPE', 'FILL', 'UNDO', 'REDO', 'CLEAR'] &&
             data.tool is string && data.tool.size() >= 1 && data.tool.size() <= 32 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 12 &&
             data.sizePx is int && data.sizePx >= 1 && data.sizePx <= 80 &&
             data.opacity is int && data.opacity >= 1 && data.opacity <= 100 &&
             data.symmetryMode is string && data.symmetryMode in ['NONE', 'MIRROR_V', 'MIRROR_H', 'RADIAL_4', 'RADIAL_6', 'RADIAL_8'] &&
             data.seed is int &&
             data.encodedData is string && data.encodedData.size() <= 65536 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 12 &&
             data.memberUids[0] is string &&
             request.auth.uid in data.memberUids &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 6. ChatMessage Validation Blueprint
    function isValidChatMessage(data, roomId) {
      return data.roomId is string && data.roomId == roomId && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderId == request.auth.uid &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.channel is string && data.channel in ['EVERYONE', 'GUESSED'] &&
             data.messageType is string && data.messageType in ['TEXT', 'EMOJI', 'STICKER', 'SYSTEM', 'GUESS_RESULT'] &&
             data.content is string && data.content.size() <= 140 &&
             data.stickerId is string && data.stickerId.size() <= 40 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 12 &&
             data.memberUids[0] is string &&
             request.auth.uid in data.memberUids &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 7. ModerationReport Validation Blueprint
    function isValidModerationReport(data) {
      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
             data.reporterId == request.auth.uid &&
             data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
             data.targetUsername is string && data.targetUsername.size() >= 1 && data.targetUsername.size() <= 40 &&
             data.roomCode is string && data.roomCode.size() == 6 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 200 &&
             data.chatSnapshotJson is string && data.chatSnapshotJson.size() <= 8000 &&
             data.status is string && data.status == 'OPEN' &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'username', 'displayName', 'avatarJson', 'bio', 'countryFlag',
                         'themeColor', 'xp', 'level', 'equippedTitle', 'equippedBadge',
                         'gamesPlayed', 'wins', 'totalPoints', 'correctGuesses', 'bestGuessMs',
                         'bestStreak', 'unlockedPacksJson', 'achievementsJson', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'displayName', 'avatarJson', 'bio', 'countryFlag',
                         'themeColor', 'xp', 'level', 'equippedTitle', 'equippedBadge',
                         'gamesPlayed', 'wins', 'totalPoints', 'correctGuesses', 'bestGuessMs',
                         'bestStreak', 'unlockedPacksJson', 'achievementsJson', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'displayName', 'avatarJson', 'bio', 'countryFlag',
                         'themeColor', 'xp', 'level', 'equippedTitle', 'equippedBadge',
                         'gamesPlayed', 'wins', 'totalPoints', 'correctGuesses', 'bestGuessMs',
                         'bestStreak', 'unlockedPacksJson', 'achievementsJson', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // /users/{userId}/friends/{friendId}
      match /friends/{friendId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(friendId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(friendId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'friendCode', 'friendUsername', 'friendDisplayName',
                           'friendAvatarJson', 'status', 'roomCode', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'friendCode', 'friendUsername', 'friendDisplayName',
                           'friendAvatarJson', 'status', 'roomCode', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFriendship(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(friendId) &&
                         isValidFriendship(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'friendUsername', 'friendDisplayName', 'friendAvatarJson',
                           'status', 'roomCode', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(friendId) && request.auth.uid == userId;
      }

      // /users/{userId}/word_packs/{packId}
      match /word_packs/{packId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(packId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(packId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'language', 'difficulty', 'isFamilyFriendly',
                           'wordsCsv', 'wordCount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'language', 'difficulty', 'isFamilyFriendly',
                           'wordsCsv', 'wordCount', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCustomWordPack(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(packId) &&
                         isValidCustomWordPack(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'language', 'difficulty', 'isFamilyFriendly',
                           'wordsCsv', 'wordCount', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(packId) && request.auth.uid == userId;
      }
    }

    // /rooms/{roomId}
    match /rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (existing().hostId == request.auth.uid ||
                     request.auth.uid in existing().memberUids ||
                     existing().isPublic == true);

      allow list: if isSignedIn() &&
                     (existing().hostId == request.auth.uid ||
                      request.auth.uid in existing().memberUids ||
                      existing().isPublic == true);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll([
                         'roomCode', 'hostId', 'hostName', 'isPublic', 'phase', 'round', 'maxRounds',
                         'drawTimeSec', 'wordChoicesCount', 'hintsCount', 'gameMode', 'difficulty',
                         'wordPackCategory', 'customWordsCsv', 'currentDrawerId', 'currentDrawerName',
                         'wordMask', 'secretWord', 'phaseEndsAtMs', 'memberUids', 'playersJson',
                         'reactionCountsJson', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'hostId', 'hostName', 'isPublic', 'phase', 'round', 'maxRounds',
                         'drawTimeSec', 'wordChoicesCount', 'hintsCount', 'gameMode', 'difficulty',
                         'wordPackCategory', 'customWordsCsv', 'currentDrawerId', 'currentDrawerName',
                         'wordMask', 'secretWord', 'phaseEndsAtMs', 'memberUids', 'playersJson',
                         'reactionCountsJson', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidGameRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidGameRoom(incoming()) &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().hostId == request.auth.uid ||
                        request.auth.uid in existing().memberUids ||
                        (existing().isPublic == true && request.auth.uid in incoming().memberUids)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'hostId', 'hostName', 'isPublic', 'phase', 'round', 'maxRounds',
                         'drawTimeSec', 'wordChoicesCount', 'hintsCount', 'gameMode', 'difficulty',
                         'wordPackCategory', 'customWordsCsv', 'currentDrawerId', 'currentDrawerName',
                         'wordMask', 'secretWord', 'phaseEndsAtMs', 'memberUids', 'playersJson',
                         'reactionCountsJson', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      // /rooms/{roomId}/ops/{opId} (Append-only vector op-log)
      match /ops/{opId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(opId) &&
                      request.auth.uid in existing().memberUids;

        allow list: if isSignedIn() &&
                       request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(opId) &&
                         incoming().keys().hasAll([
                           'roomId', 'authorId', 'seq', 'opType', 'tool', 'colorHex',
                           'sizePx', 'opacity', 'symmetryMode', 'seed', 'encodedData',
                           'memberUids', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'authorId', 'seq', 'opType', 'tool', 'colorHex',
                           'sizePx', 'opacity', 'symmetryMode', 'seed', 'encodedData',
                           'memberUids', 'createdAt'
                         ]) &&
                         isValidCanvasOp(incoming(), roomId);

        allow update, delete: if false;
      }

      // /rooms/{roomId}/messages/{messageId} (Append-only room chat & stickers)
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(messageId) &&
                      request.auth.uid in existing().memberUids;

        allow list: if isSignedIn() &&
                       request.auth.uid in existing().memberUids;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll([
                           'roomId', 'senderId', 'senderName', 'channel', 'messageType',
                           'content', 'stickerId', 'memberUids', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderId', 'senderName', 'channel', 'messageType',
                           'content', 'stickerId', 'memberUids', 'createdAt'
                         ]) &&
                         isValidChatMessage(incoming(), roomId);

        allow update, delete: if false;
      }
    }

    // /reports/{reportId} (Insert-only moderation reports, owner readable)
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().reporterId == request.auth.uid;
      allow list: if isSignedIn() && existing().reporterId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().keys().hasAll([
                         'reporterId', 'targetUserId', 'targetUsername', 'roomCode',
                         'reason', 'chatSnapshotJson', 'status', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'reporterId', 'targetUserId', 'targetUsername', 'roomCode',
                         'reason', 'chatSnapshotJson', 'status', 'createdAt'
                       ]) &&
                       isValidModerationReport(incoming());

      allow update, delete: if false;
    }
  }
}
